# Copiar para `.env` no servidor de aplicação (192.168.1.25) antes do primeiro deploy.
# Nunca versionar `.env` real — apenas este `.env.example`.
DB_NAME=patrimonial
DB_USER=patrimonial
DB_PASSWORD=trocar-por-uma-senha-forte

# Porta do host onde a aplicação responde.
# No servidor Umbrel (192.168.1.25) as portas 80, 81, 8080, 8081 e 3000 estão ocupadas.
APP_PORT=8082

# Proxy reverso / transporte.
# APP_BIND=127.0.0.1 publica a porta só para o proxy no próprio host (recomendado quando o
# acesso HTTPS pelo proxy estiver ativo); 0.0.0.0 mantém o acesso direto pela LAN em HTTP.
APP_BIND=0.0.0.0
# Regex dos IPs de proxy confiáveis para X-Forwarded-*. Vazio = redes bridge do Docker + loopback.
# Ajuste se o NPM chegar à aplicação por outro IP (confira o IP gravado na auditoria).
#TRUSTED_PROXIES=
# true = cookie de sessão sempre com Secure (só quando TODO acesso for por HTTPS).
SESSION_COOKIE_SECURE=false

# Senha do administrador inicial 'admin' (só usada quando o banco ainda não tem nenhum
# administrador ativo). Deixe vazia para o boot gerar uma senha aleatória e mostrá-la uma
# única vez no log (`docker compose logs app | grep "senha provisória"`). Em ambos os casos
# a senha é provisória: a API só libera a troca de senha até o primeiro acesso.
APP_ADMIN_SENHA=

# Integração com o Almoxarifado (opcional). Quando definida, o boot cria/atualiza o
# usuário técnico 'integracao.almoxarifado' (perfil INTEGRACAO) com esta senha.
# No Almoxarifado use os mesmos valores em PATRIMONIO_USUARIO / PATRIMONIO_SENHA.
INTEGRACAO_ALMOXARIFADO_SENHA=

# Frota: importação do sistema Transportes FPTO (opcional). Com a URL definida, a cada boot
# (e pelo botão "Importar do Transportes" na tela Frota) os veículos e o histórico de
# abastecimentos/manutenções/deslocamentos são copiados sem duplicar.
# Transportes com banco próprio (compose.yaml do transportes, porta 5433 no host):
#   TRANSPORTES_DB_URL=jdbc:postgresql://host.docker.internal:5433/transportes
# Transportes no PostgreSQL do Protocantins (compose.banco-existente.yaml): use o nome do
# container na mesma rede docker, ex. jdbc:postgresql://protocantins-db:5432/transportes
TRANSPORTES_DB_URL=
TRANSPORTES_DB_USER=transportes
TRANSPORTES_DB_SENHA=
TRANSPORTES_IMPORTAR_NO_BOOT=true

# Homologação: popula a frota com 6 veículos e 90 dias de histórico de demonstração
# (usuário motorista.demo, perfil MOTORISTA). NÃO ligar em produção.
FROTA_SEED=false
FROTA_SEED_SENHA_MOTORISTA=trocar123
